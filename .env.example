# ==============================================================================
# Event-Driven Telemetry Mesh - Environment Configuration
# ==============================================================================

# Application Runtime Configuration
APP_NAME=event-driven-telemetry-mesh
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# Redis Streams Message Broker
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_RAW=telemetry:stream:raw
REDIS_STREAM_ANOMALIES=telemetry:stream:anomalies
REDIS_CONSUMER_GROUP=telemetry:workers:group
REDIS_CONSUMER_NAME=worker-node-1
REDIS_STREAM_MAX_LEN=100000
REDIS_BATCH_SIZE=50
REDIS_BLOCK_MS=1000
REDIS_CLAIM_MIN_IDLE_MS=10000

# TimescaleDB Time-Series Metric Persistence
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/telemetry_db
DB_ENABLED=true
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Ollama AI Inference Worker Pool
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT_SECONDS=15.0
OLLAMA_ENABLED=true
OLLAMA_FALLBACK_MOCK=true
OLLAMA_CONCURRENCY=4

# Sliding Window & Analytical Buffer
WINDOW_SIZE_SAMPLES=30
WINDOW_MAX_TIME_SPAN_SECONDS=120

# Deterministic Rig Safety & Drilling Physics Thresholds
THRESHOLD_WOB_MAX=55.0
THRESHOLD_WOB_MIN=5.0
THRESHOLD_RPM_MAX=220.0
THRESHOLD_RPM_MIN=30.0
THRESHOLD_TORQUE_MAX=35.0
THRESHOLD_SPP_MAX=4800.0
THRESHOLD_FLOW_IN_MAX=950.0
THRESHOLD_FLOW_DELTA_PERCENT=15.0
THRESHOLD_STICK_SLIP_RPM_RATIO=0.6

# Multi-Rig Synthetic Telemetry Simulator
SIMULATOR_RIGS=3
SIMULATOR_FREQUENCY_HZ=5.0
SIMULATOR_AUTO_ANOMALY_INTERVAL_SEC=45
